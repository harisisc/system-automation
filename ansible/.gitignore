# Ansible runtime
*.retry

# Vault password - never commit this, it decrypts every secret in the repo.
.vault_pass

# Local/ad-hoc inventory files (e.g. throwaway test inventories) - the
# real, tracked inventory content is explicitly allowlisted below.
inventory/*

!inventory/hosts.yaml
!inventory/group_vars/
!inventory/group_vars/all.yaml
!inventory/host_vars/

# Avatar images are real photos - never commit them, even though
# group_vars/ itself is tracked above.
inventory/group_vars/avatars/*

# external installs
collections/*

!collections/
!collections/requirements.yaml

roles_external/*

!roles_external/
!roles_external/requirements.yaml
