# Ansible runtime
*.retry

# Vault password - never commit this, it decrypts every secret in the repo.
.vault_pass

# Real inventory - hostnames, IPs, real names, avatar photos. Never
# committed; inventory.example/ (tracked) mirrors its structure with
# dummy data. See README.md for copying it into place.
inventory/

# external installs
collections/*

!collections/
!collections/requirements.yaml

roles_external/*

!roles_external/
!roles_external/requirements.yaml
