#cloud-config
autoinstall:
  version: 1

  locale: en_US.UTF-8
  keyboard:
    layout: us

  identity:
    hostname: ubuntu
    username: ubuntu
    # Shared, hardcoded default password ("changeme"), same idea as the
    # LUKS passphrase below - this account is only a placeholder for
    # install; Ansible creates the real users, and ../ansible connects as
    # its own key-only "ansible" service account below. Change this
    # password after first boot (e.g. `sudo passwd ubuntu`), same as the
    # LUKS passphrase.
    password: "$6$7Bpi1korzyYkEumk$/y6Wf/x9G2WF8wul.HOs7Rgy5Ku.yPn7qE9wYanoA7IV11WoIzcZ4R1XY2e3jDxMGskfg5UNQdj.LaqMV0TfJ."

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - __ANSIBLE_SSH_PUBLIC_KEY__

  storage:
    layout:
      name: lvm
      # Fixed for now - same passphrase on every install. Change it after
      # first boot with cryptsetup luksChangeKey (see README).
      password: "changeme"

  packages:
    - openssh-server
    - python3
    - python3-apt
    - sudo

  user-data:
    users:
      - name: ansible
        gecos: Ansible Service Account
        groups:
          - sudo
        shell: /bin/bash
        sudo: ALL=(ALL) NOPASSWD:ALL
        lock_passwd: true
        ssh_authorized_keys:
          - __ANSIBLE_SSH_PUBLIC_KEY__

  late-commands:
    - curtin in-target -- systemctl enable ssh
