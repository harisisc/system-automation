#cloud-config
autoinstall:
  version: 1

  locale: en_US.UTF-8
  keyboard:
    layout: us

  identity:
    hostname: ubuntu
    username: ubuntu
    # "!" is the standard Linux convention for a locked account (no hash
    # will ever match it) - this account is only a placeholder for install;
    # Ansible creates the real users, and ../ansible connects as its own
    # key-only "ansible" service account below.
    password: "!"

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - __ANSIBLE_SSH_PUBLIC_KEY__

  storage:
    layout:
      name: lvm
      password: "__LUKS_PASSWORD__"

  packages:
    - openssh-server
    - python3
    - python3-apt
    - sudo

  user-data:
    users:
      - name: ansible
        gecos: Ansible Service Account
        groups:
          - sudo
        shell: /bin/bash
        sudo: ALL=(ALL) NOPASSWD:ALL
        lock_passwd: true
        ssh_authorized_keys:
          - __ANSIBLE_SSH_PUBLIC_KEY__

  late-commands:
    - curtin in-target -- systemctl enable ssh
