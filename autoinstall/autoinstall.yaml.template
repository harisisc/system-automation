#cloud-config
autoinstall:
  version: 1

  locale: en_US.UTF-8
  keyboard:
    layout: us
  # Keep in sync with system_timezone in ../ansible's group_vars.
  timezone: America/New_York

  identity:
    hostname: ubuntu
    username: ubuntu
    # Shared, hardcoded default password ("changeme"), same idea as the
    # LUKS passphrase below - this account is only a placeholder for
    # install; Ansible creates the real users, and ../ansible connects as
    # its own key-only "ansible" service account below. Change this
    # password after first boot (e.g. `sudo passwd ubuntu`), same as the
    # LUKS passphrase.
    password: "$6$7Bpi1korzyYkEumk$/y6Wf/x9G2WF8wul.HOs7Rgy5Ku.yPn7qE9wYanoA7IV11WoIzcZ4R1XY2e3jDxMGskfg5UNQdj.LaqMV0TfJ."

  ssh:
    install-server: true
    allow-pw: true
    authorized-keys:
      - __ANSIBLE_SSH_PUBLIC_KEY__

  # Explicit layout (the `layout: lvm` shortcut can't size individual LVs):
  # GPT on the largest disk -> 1G ESP, 2G /boot, rest LUKS -> LVM with
  # / at 100G and /home at 300G. Needs a disk of at least ~410GB; any
  # space beyond that stays free in ubuntu-vg for growing either LV later
  # (lvextend -r). UEFI only - there's no BIOS boot partition.
  storage:
    config:
      - type: disk
        id: disk-main
        match:
          size: largest
        ptable: gpt
        wipe: superblock-recursive
        preserve: false
        grub_device: false

      - type: partition
        id: part-efi
        device: disk-main
        number: 1
        size: 1G
        flag: boot
        grub_device: true
        wipe: superblock
        preserve: false
      - type: format
        id: fmt-efi
        volume: part-efi
        fstype: fat32
        preserve: false

      - type: partition
        id: part-boot
        device: disk-main
        number: 2
        size: 2G
        wipe: superblock
        preserve: false
      - type: format
        id: fmt-boot
        volume: part-boot
        fstype: ext4
        preserve: false

      - type: partition
        id: part-luks
        device: disk-main
        number: 3
        size: -1
        wipe: superblock
        preserve: false
      - type: dm_crypt
        id: crypt-main
        volume: part-luks
        dm_name: dm_crypt-0
        # Fixed for now - same passphrase on every install. Change it after
        # first boot with cryptsetup luksChangeKey (see README).
        key: "changeme"
        preserve: false

      - type: lvm_volgroup
        id: vg-main
        name: ubuntu-vg
        devices:
          - crypt-main
        preserve: false

      - type: lvm_partition
        id: lv-root
        volgroup: vg-main
        name: ubuntu-lv
        size: 100G
        wipe: superblock
        preserve: false
      - type: format
        id: fmt-root
        volume: lv-root
        fstype: ext4
        preserve: false

      - type: lvm_partition
        id: lv-home
        volgroup: vg-main
        name: home-lv
        size: 300G
        wipe: superblock
        preserve: false
      - type: format
        id: fmt-home
        volume: lv-home
        fstype: ext4
        preserve: false

      - type: mount
        id: mnt-root
        device: fmt-root
        path: /
      - type: mount
        id: mnt-boot
        device: fmt-boot
        path: /boot
      - type: mount
        id: mnt-efi
        device: fmt-efi
        path: /boot/efi
      - type: mount
        id: mnt-home
        device: fmt-home
        path: /home

  packages:
    - openssh-server
    - python3
    - python3-apt
    - sudo

  user-data:
    users:
      - name: ansible
        gecos: Ansible Service Account
        groups:
          - sudo
        shell: /bin/bash
        sudo: ALL=(ALL) NOPASSWD:ALL
        lock_passwd: true
        ssh_authorized_keys:
          - __ANSIBLE_SSH_PUBLIC_KEY__

  late-commands:
    - curtin in-target -- systemctl enable ssh
